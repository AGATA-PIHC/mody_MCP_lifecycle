DATABRICKS_HOST=https://your-databricks-instance.cloud.databricks.com
DATABRICKS_TOKEN=your-databricks-personal-access-token
DATABRICKS_SQL_WAREHOUSE_ID=your-sql-warehouse-id
# Minimal 32 karakter: python -c "import secrets;print(secrets.token_urlsafe(32))"
MCP_API_KEY=random-long-key-shared-with-mody-agent
# Wajib diisi (server menolak start kalau kosong), sama untuk dua prefix di bawah dan GITHUB_BRANCH_PREFIX
ALLOWED_CATALOGS=mody_dev
ALLOWED_EXPERIMENT_PREFIX=/Shared/mody/
ALLOWED_JOB_PREFIX=mody_
# Fine-grained token, hanya repo ini: Contents RW, Pull requests RW, Actions R, Checks R. JANGAN beri Workflows.
GITHUB_TOKEN=github_pat_xxx
GITHUB_REPO=AGATA-PIHC/ml-ops-databricks
GITHUB_BASE_BRANCH=main
GITHUB_BRANCH_PREFIX=agent/
GITHUB_ALLOWED_PATHS=usecases/*/*.yml,src/mody_ml/usecases/*/*.py,tests/unit/test_*.py,notebooks/training/*/*
MAX_ROWS=100
# Default 127.0.0.1. Isi 0.0.0.0 hanya kalau agent di mesin lain dan ada reverse proxy TLS di depan.
HOST=127.0.0.1
PORT=8000
